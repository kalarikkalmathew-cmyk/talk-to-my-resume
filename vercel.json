{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "functions": {
    "api/chat.mjs": {
      "includeFiles": "system-prompt.md"
    }
  },
  "rewrites": [
    { "source": "/.well-known/ai-resume.json", "destination": "/ai-resume.json" },
    { "source": "/resume.pdf", "destination": "/public/mathew-kalarikkal-resume.pdf" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
